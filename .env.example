# Any OpenAI-compatible chat endpoint: Ollama locally, vLLM on LUMI (through the SSH tunnel), or a hosted API.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:14b
LLM_API_KEY=ollama
LLM_TIMEOUT_S=300
# Reasoning models: "none" turns thinking off for Qwen3-style models; gpt-oss takes low/medium/high
LLM_REASONING_EFFORT=

# Where the numbers come from: "local" (the organizers' 18 Oct snapshot in data/release, live PX-API for what it lacks),
# "pxapi" (live Statistics Iceland PX-API), "fixtures" (offline, data/fixtures)
DATA_SOURCE=local
LOCAL_DATA_DIR=data/release/data
PX_BASE_URL=https://px.hagstofa.is
# Minimum seconds between PX-API calls. The API answers 429 when hit too fast.
PX_MIN_INTERVAL_S=1.0

CATALOG_PATH=data/catalog_live.json
FIXTURES_DIR=data/fixtures
CACHE_DIR=.cache

# e5 vector search beside keyword search (hagbot/e5.py). Needs: pip install -r requirements-e5.txt
# The first start embeds every table (a few minutes on CPU) and caches the vectors in CACHE_DIR.
USE_E5=0
E5_MODEL=intfloat/multilingual-e5-large
E5_CARD=multi
E5_DEVICE=
TABLES_META_PATH=data/tables_20261030_224153.json

# How many catalog hits the reranker sees
RETRIEVE_TOP_K=15
